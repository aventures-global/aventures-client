# Formspree form hashid (from https://formspree.io/forms → your form → endpoint)
# Set the same key in Vercel Project Settings → Environment Variables for production.
VITE_FORMSPREE_ID=

# Canonical site origin used in sitemap.xml / robots.txt (no trailing slash).
# Defaults to https://aventures-client.vercel.app if unset.
VITE_SITE_URL=https://aventures-client.vercel.app

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to skip loading analytics. Set the same key in Vercel for production.
VITE_GA_ID=
